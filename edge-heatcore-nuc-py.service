[Unit]
Description=Docker Application Service for Edge Heatcore Nuc
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/heatcore/ehn-py
ExecStart=sh -c 'export PATH=$PATH:/snap/bin;docker run -d --name edge-nuc --restart=always -v /etc/heatcore/ehn-py:/data -v /etc/heatcore/ehn-py/logs:/tmp/edge-nuc/logs --net host --privileged 713613010142.dkr.ecr.ap-southeast-1.amazonaws.com/edge-heatcore-nuc:latest'
ExecStop=sh -c 'export PATH=$PATH:/snap/bin;docker stop edge-nuc;docker rm edge-nuc'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
